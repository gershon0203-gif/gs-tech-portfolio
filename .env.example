# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` for local development, and set the
# same values in your hosting provider's dashboard.
# ─────────────────────────────────────────────────────────────

# Optional: point the contact form at a different endpoint.
# Leave empty locally to use the prefilled email draft fallback.
# In production the form defaults to /.netlify/functions/contact.
VITE_CONTACT_ENDPOINT=

# ── Server-side only (Netlify function) ───────────────────────
# These are NOT exposed to the browser. Never prefix them with VITE_.
#
# RESEND_API_KEY     — from https://resend.com/api-keys
# CONTACT_TO_EMAIL   — inbox that should receive enquiries
# CONTACT_FROM_EMAIL — a sender on a domain verified in Resend
#                      e.g. "GS TECH <hello@gstech.dev>"
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
